# Jira Configuration
JIRA_BASE_URL=https://your-jira-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-api-token

# UNM (User Management) Configuration
UNM_BASE_URL=https://unm-api.example.com
UNM_API_KEY=your-unm-api-key

# Member Services Configuration
MEMBER_SERVICE_BASE_URL=https://member-api.example.com
MEMBER_SERVICE_API_KEY=your-member-api-key

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tix_member_core
DB_USER=your-db-user
DB_PASSWORD=your-db-password

# TestRail Configuration
TESTRAIL_BASE_URL=https://tiket.testrail.com
TESTRAIL_API_KEY=your-testrail-api-key

# Slack/Notification Configuration (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
