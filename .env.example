# ──────────────────────────────────────────────
# QA Member Tools — Environment Configuration
# ──────────────────────────────────────────────

# Web UI Server
PORT=3456

# API Authentication (set to enable API key auth; leave blank to disable)
API_KEY=

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ─── Jira Configuration ───────────────────────
JIRA_BASE_URL=https://your-jira-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-api-token

# ─── TestRail Configuration ───────────────────
TESTRAIL_BASE_URL=https://tiket.testrail.com
TESTRAIL_USER=your-email@company.com
TESTRAIL_API_KEY=your-testrail-api-key

# ─── UNM Auth Headers — Test Environment ──────
UNM_TEST_CHALLENGE=your-test-challenge-id
UNM_TEST_CHALLENGE_SIGNATURE=your-test-challenge-signature
UNM_TEST_USERNAME=your-test-username@example.com

# ─── UNM Auth Headers — Preprod Environment ───
UNM_PREPROD_CHALLENGE=your-preprod-challenge-id
UNM_PREPROD_CHALLENGE_SIGNATURE=your-preprod-challenge-signature
UNM_PREPROD_USERNAME=your-preprod-username@example.com

# ─── Database Configuration (MySQL) ───────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tix_member_core
DB_USER=your-db-user
DB_PASSWORD=your-db-password

# ─── Security ─────────────────────────────────
# Curl-Call SSRF Allowlist (comma-separated hostnames; leave blank to allow all)
ALLOWED_CURL_HOSTS=
